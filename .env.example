# ─── Banco de dados (PostgreSQL) ────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (porta 6543)
# Usado pelo app (Drizzle) em runtime. Nunca exponha ao navegador.
DATABASE_URL=postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Conexão direta/sessão (porta 5432) usada só por migrations. Se vazio, usa DATABASE_URL.
DATABASE_MIGRATION_URL=

# ─── Supabase (Auth + Storage) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Chave pública (anon / publishable). Pode ir ao navegador: o RLS bloqueia acesso direto às tabelas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service role). SOMENTE servidor. Usada para Storage e seed.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado para fotos e comprovantes
SUPABASE_STORAGE_BUCKET=lucroflow

# ─── App ────────────────────────────────────────────────────────────────────
# URL pública do app (links de confirmação de e-mail / recuperação de senha)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Nível de log do servidor: debug | info | warn | error
LOG_LEVEL=info

# ─── Seed (opcional) ────────────────────────────────────────────────────────
# Usuário demo criado no Supabase Auth por `npm run db:seed` (requer SUPABASE_SERVICE_ROLE_KEY)
SEED_DEMO_EMAIL=demo@lucroflow.app
SEED_DEMO_PASSWORD=
